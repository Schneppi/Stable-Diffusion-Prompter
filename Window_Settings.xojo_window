#tag WindowCode
	#tag Method, Flags = &h0
		Function Save_SDHostSettings() As Boolean
		  Try
		    
		    App.SDP_Database.ExecuteSQL("UPDATE preferences SET pref_setting=? WHERE pref_name='SDP Address'", App.SD_Host.HostAddress)
		    App.SDP_Database.ExecuteSQL("UPDATE preferences SET pref_setting=? WHERE pref_name='SDP Path'", App.SD_Host.HostAPIPath)
		    App.SDP_Database.ExecuteSQL("UPDATE preferences SET pref_setting=? WHERE pref_name='SDP Port'", App.SD_Host.HostPort)
		    App.SDP_Database.ExecuteSQL("UPDATE preferences SET pref_setting=? WHERE pref_name='SDP Use Model'", App.SD_Host.Use_Model)
		    
		    Return True
		    
		  Catch err As DatabaseException
		    
		    System.Log(System.LogLevelError, CurrentMethodName + " - Error Code: " + err.ErrorNumber.ToString + EndOfLine + "Error Message: " + err.Message)
		    
		  End Try
		End Function
	#tag EndMethod


#tag EndWindowCode

#tag Events Button_SaveSettings
	#tag Event
		Sub Pressed()
		  App.SD_Host.HostAddress = TextField_SDHost_Address.Text.Trim
		  App.SD_Host.HostAPIPath = TextField_SDHost_APIPath.Text.Trim
		  App.SD_Host.HostPort = TextField_SDHost_Port.Text.ToInteger
		  App.SD_Host.Use_Model = CheckBox_UseModel.Value
		  
		  If Save_SDHostSettings Then
		    
		    Self.Close
		    
		  Else
		    
		  End If
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Timer_PrepareUI
	#tag Event
		Sub Action()
		  Load_SDHostSettings
		  
		  TextField_SDHost_Address.Text = App.SD_Host.HostAddress
		  TextField_SDHost_APIPath.Text = App.SD_Host.HostAPIPath
		  TextField_SDHost_Port.Text = App.SD_Host.HostPort.ToString
		  CheckBox_UseModel.Value = App.SD_Host.Use_Model
		End Sub
	#tag EndEvent
#tag EndEvents
